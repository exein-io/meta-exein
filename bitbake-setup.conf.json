{
    "version": "1.0",
    "description": "Yocto test image for Pulsar (open-source, built from source; Blacksail, pinned to SHAs for reproducibility)",
    "sources": {
        "bitbake": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "git://git.openembedded.org/bitbake;protocol=https"
                    }
                },
                "branch": "master",
                "rev": "6f5ecebbebd117fca0326fe5e78bbe487ef8a1e1"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "git://git.openembedded.org/openembedded-core;protocol=https"
                    }
                },
                "branch": "blacksail",
                "rev": "7cf4f7565fd45642d300f26ba4aa69d0150a205e"
            },
            "path": "openembedded-core"
        },
        "meta-yocto": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "git://git.yoctoproject.org/meta-yocto;protocol=https"
                    }
                },
                "branch": "blacksail",
                "rev": "d36c827e02ab138b446386792fd7588b5a041507"
            },
            "path": "meta-yocto"
        },
        "meta-openembedded": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "git://git.openembedded.org/meta-openembedded;protocol=https"
                    }
                },
                "branch": "master",
                "rev": "daddebfde34cf6c5c140373b8a06f93a0649124f"
            },
            "path": "meta-openembedded"
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "name": "exein-pulsar-test",
                "description": "Minimal QEMU build for testing the open-source Pulsar recipe",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-poky",
                    "meta-openembedded/meta-oe"
                ],
                "bb-layers-file-relative": [
                    "."
                ],
                "oe-fragments": [
                    "core/yocto/sstate-mirror-cdn",
                    "meta-exein/pulsar",
                    "meta-exein/optimizations",
                    "distro/poky-altcfg"
                ],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machine architecture",
                        "options": [
                            "machine/qemuarm64",
                            "machine/qemuriscv64",
                            "machine/qemux86-64"
                        ]
                    }
                }
            }
        ]
    }
}
